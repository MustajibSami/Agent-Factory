# Copy this file to .env and fill in what you use. Never commit .env.

# Claude models (only needed when config.toml has [llm] mode = "live")
ANTHROPIC_API_KEY=

# YouTube Data API key, for real trending videos (otherwise sample trends are used)
YOUTUBE_API_KEY=

# SMTP account for outreach (only used when [outreach] live = true)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Instagram Business Discovery (optional): your own Instagram professional account's ID and a token
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Brave Search API (optional, paid per search)
BRAVE_API_KEY=
